{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analysis-ir.local/contracts/evidence-bundle-1.0.0.json",
  "title": "证据束：结果文件、校验摘要、检查记录（与本次运行绑定）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "run_id", "plan_digest", "items"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evidence_id": {"type": "string", "pattern": "^evidence-[a-z0-9-]+$"},
    "run_id": {"type": "string", "pattern": "^run-[0-9]{4,}$"},
    "plan_digest": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/digest64"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "step_id", "kind", "artifact", "artifact_digest", "generated_at", "status"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^ev-[a-z0-9-]+$"},
          "step_id": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/step_id"},
          "kind": {"enum": ["method-output", "check-record"]},
          "method_or_check_version": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/semver"},
          "artifact": {"type": "string", "minLength": 1},
          "artifact_digest": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/digest64"},
          "generated_at": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/iso_datetime"},
          "status": {"enum": ["PASS", "FAIL", "WARN", "UNKNOWN", "NOT_APPLICABLE"]},
          "check_id": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/method_ref"},
          "actual_value": {},
          "threshold": {},
          "failure_action": {"enum": ["block-step", "block-acceptance", "require-acknowledgement"]}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
