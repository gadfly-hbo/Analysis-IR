{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analysis-ir.local/contracts/analysis-plan-ir-1.0.0.json",
  "title": "正式分析计划：方法步骤、依赖、参数、验证要求与输出契约",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "plan_version", "contract_ref", "binding_ref",
    "dataset_refs", "metric_refs", "method_registry_ref", "check_registry_ref",
    "execution_policy_ref", "steps", "required_check_refs", "output_contract"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "plan_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "plan_version": {"type": "integer", "minimum": 1},
    "contract_ref": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/object_ref"},
    "binding_ref": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/object_ref"},
    "dataset_refs": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/object_ref"}
    },
    "metric_refs": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/object_ref"}
    },
    "method_registry_ref": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/registry_ref"},
    "check_registry_ref": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/registry_ref"},
    "execution_policy_ref": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/object_ref"},
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "method_ref", "depends_on", "inputs", "outputs"],
        "properties": {
          "step_id": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/step_id"},
          "method_ref": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/method_ref"},
          "depends_on": {
            "type": "array",
            "items": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/step_id"}
          },
          "inputs": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(@[0-9]+)?$"}
          },
          "params": {"type": "object"},
          "params_ref": {"type": "string", "minLength": 1},
          "outputs": {
            "type": "array", "minItems": 1,
            "items": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/artifact_name"}
          }
        }
      }
    },
    "required_check_refs": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/method_ref"}
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_artifacts", "allowed_finding_types", "require_evidence_refs", "require_limitations"],
      "properties": {
        "required_artifacts": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "https://analysis-ir.local/contracts/common-1.0.0.json#/$defs/artifact_name"}
        },
        "allowed_finding_types": {
          "type": "array", "minItems": 1,
          "items": {"enum": ["descriptive", "arithmetic-decomposition"]}
        },
        "require_evidence_refs": {"const": true},
        "require_limitations": {"const": true}
      }
    }
  }
}
